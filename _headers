# ============================================================
# Cloudflare Pages _headers — keyscodesandmodes.com
# Updated: 2026-03-25
# ============================================================

# ── Sitemap ────────────────────────────────────────────────
/sitemap.xml
  Content-Type: application/xml; charset=UTF-8
  Cache-Control: public, max-age=3600

# ── robots.txt ─────────────────────────────────────────────
/robots.txt
  Content-Type: text/plain; charset=UTF-8
  Cache-Control: public, max-age=3600

# ── HTML pages ─────────────────────────────────────────────
/*.html
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# ── Root ───────────────────────────────────────────────────
/
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

# ── Site scripts: always revalidate (added 2026-10-10). Pages' default is a 4-hour
# browser cache, which kept a broken session script alive in browsers after a fix.
/js/*
  Cache-Control: public, max-age=0, must-revalidate

# ── Assets (long cache) ────────────────────────────────────
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/kcm-official-logo-32.png
  Cache-Control: public, max-age=31536000, immutable

# ── Site-wide security (added 2026-10-04, student-privacy audit) ──
# CSP added 2026-10-10 in REPORT-ONLY mode: it blocks nothing, it only logs violations
# to the browser console (DevTools > Console). Review those, tighten, then rename the
# header to Content-Security-Policy to enforce. 'unsafe-inline' stays until inline scripts are moved out.
/*
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://static.cloudflareinsights.com https://assets.mailerlite.com blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; media-src 'self' data: blob: https://gleitz.github.io; connect-src 'self' https://console.keyscodesandmodes.com https://mtp.keyscodesandmodes.com https://snowy-rain-84a5.benryan1.workers.dev https://snowy-rain-84a5.ben-03b.workers.dev https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://cdn.jsdelivr.net https://gleitz.github.io https://raw.githubusercontent.com https://api.github.com https://connect.mailerlite.com https://formspree.io https://cloudflareinsights.com https://static.cloudflareinsights.com; worker-src 'self' blob:; frame-src 'self' https://assets.mailerlite.com https://www.youtube.com https://player.vimeo.com; form-action 'self' https://assets.mailerlite.com https://connect.mailerlite.com https://formspree.io https://buy.stripe.com; frame-ancestors 'self'; base-uri 'self'; object-src 'none'
